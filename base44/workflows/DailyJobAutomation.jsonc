{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "daily_job_automation",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "coleta": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "runJobCollection"
          },
          "then": "processamento",
          "x-base44": {
            "title": "Coletar vagas",
            "description": "Busca vagas em fontes autorizadas"
          }
        }
      },
      {
        "processamento": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "runCandidateProcessing"
          },
          "then": "end",
          "x-base44": {
            "title": "Processar candidatos",
            "description": "Analisa compatibilidade e cria candidaturas"
          }
        }
      }
    ]
  },
  "name": "Automa\u00e7\u00e3o Di\u00e1ria de Vagas",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 6 * * *",
      "one_time_date": null,
      "timezone": "America/Manaus",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "description": "Coleta vagas diariamente do Jobicy e processa candidatos com prefer\u00eancias compat\u00edveis. Cria candidaturas AGUARDANDO_APROVACAO. WhatsApp e envios permanecem bloqueados at\u00e9 configura\u00e7\u00e3o."
}