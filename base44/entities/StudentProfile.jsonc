{
  "name": "StudentProfile",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "birth_date": {
      "type": "string",
      "format": "date"
    },
    "university": {
      "type": "string"
    },
    "course": {
      "type": "string"
    },
    "semester": {
      "type": "string"
    },
    "graduation_year": {
      "type": "string"
    },
    "bio": {
      "type": "string"
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "areas_interest": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "linkedin_url": {
      "type": "string"
    },
    "github_url": {
      "type": "string"
    },
    "portfolio_url": {
      "type": "string"
    },
    "profile_complete": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "full_name"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}