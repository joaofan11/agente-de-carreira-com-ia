{
  "name": "UserIntegration",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "owner_user_id": {
      "type": "string"
    },
    "provedor": {
      "type": "string",
      "enum": [
        "whatsapp",
        "email_api",
        "vagas_api"
      ]
    },
    "status_conexao": {
      "type": "string",
      "enum": [
        "conectado",
        "pendente",
        "desconectado",
        "erro"
      ],
      "default": "desconectado"
    },
    "identificador_conta": {
      "type": "string"
    },
    "referencia_credencial_segura": {
      "type": "string"
    },
    "notificacoes_ativas": {
      "type": "boolean",
      "default": false
    },
    "atualizado_em": {
      "type": "string",
      "format": "date-time"
    },
    "is_demo": {
      "type": "boolean",
      "default": false
    },
    "demo_batch_id": {
      "type": "string"
    }
  },
  "required": [
    "provedor"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "$and": [
            {
              "data.owner_user_id": "{{user.id}}"
            },
            {
              "data.owner_user_id": {
                "$exists": true,
                "$nin": [
                  "",
                  null
                ]
              }
            }
          ]
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "service_role_only"
      }
    },
    "update": {
      "user_condition": {
        "role": "service_role_only"
      }
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}