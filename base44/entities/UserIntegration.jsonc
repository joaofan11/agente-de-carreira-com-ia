{
  "name": "UserIntegration",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "provedor": {
      "type": "string",
      "enum": [
        "whatsapp",
        "email_api",
        "vagas_api"
      ]
    },
    "status_conexao": {
      "type": "string",
      "enum": [
        "conectado",
        "pendente",
        "desconectado",
        "erro"
      ],
      "default": "desconectado"
    },
    "identificador_conta": {
      "type": "string"
    },
    "referencia_credencial_segura": {
      "type": "string"
    },
    "atualizado_em": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "provedor"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}