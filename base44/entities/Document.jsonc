{
  "name": "Document",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "cpf",
        "rg",
        "diploma",
        "historico",
        "comprovante_residencia",
        "curriculo",
        "outro"
      ],
      "default": "outro"
    },
    "file_uri": {
      "type": "string"
    },
    "file_name": {
      "type": "string"
    },
    "mime_type": {
      "type": "string"
    },
    "size": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "pendente",
        "verificado"
      ],
      "default": "pendente"
    }
  },
  "required": [
    "title",
    "type"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}