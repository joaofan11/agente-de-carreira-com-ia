{
  "name": "Application",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "job_id": {
      "type": "string"
    },
    "resume_version_id": {
      "type": "string"
    },
    "codigo_aprovacao": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "rascunho",
        "pendente_aprovacao",
        "aprovado",
        "enviado",
        "em_analise",
        "recusado",
        "entrevista"
      ],
      "default": "rascunho"
    },
    "metodo_envio": {
      "type": "string",
      "enum": [
        "whatsapp",
        "email",
        "link_externo"
      ]
    },
    "aprovado_em": {
      "type": "string",
      "format": "date-time"
    },
    "enviado_em": {
      "type": "string",
      "format": "date-time"
    },
    "identificador_envio": {
      "type": "string"
    },
    "comprovante": {
      "type": "string"
    },
    "erro": {
      "type": "string"
    },
    "criado_em": {
      "type": "string",
      "format": "date-time"
    },
    "is_demo": {
      "type": "boolean",
      "default": false
    },
    "demo_batch_id": {
      "type": "string"
    }
  },
  "required": [
    "job_id"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}