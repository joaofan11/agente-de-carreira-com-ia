{
  "name": "Application",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "owner_user_id": {
      "type": "string"
    },
    "job_id": {
      "type": "string"
    },
    "resume_version_id": {
      "type": "string"
    },
    "codigo_aprovacao": {
      "type": "string"
    },
    "codigo_aprovacao_expira_em": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "rascunho",
        "pendente_aprovacao",
        "aprovado",
        "acao_manual_necessaria",
        "enviado",
        "em_analise",
        "recusado",
        "entrevista",
        "cancelada_duplicada"
      ],
      "default": "rascunho"
    },
    "metodo_envio": {
      "type": "string",
      "enum": [
        "email",
        "gmail",
        "outlook",
        "api_direta",
        "manual"
      ]
    },
    "aprovado_em": {
      "type": "string",
      "format": "date-time"
    },
    "canal_aprovacao": {
      "type": "string",
      "enum": [
        "in_app",
        "whatsapp"
      ],
      "default": "in_app"
    },
    "origem_aprovacao": {
      "type": "string"
    },
    "rejeitado_em": {
      "type": "string",
      "format": "date-time"
    },
    "motivo_rejeicao": {
      "type": "string"
    },
    "enviado_em": {
      "type": "string",
      "format": "date-time"
    },
    "identificador_envio": {
      "type": "string"
    },
    "comprovante": {
      "type": "string"
    },
    "link_oficial": {
      "type": "string"
    },
    "motivo_bloqueio": {
      "type": "string"
    },
    "erro": {
      "type": "string"
    },
    "criado_em": {
      "type": "string",
      "format": "date-time"
    },
    "is_demo": {
      "type": "boolean",
      "default": false
    },
    "demo_batch_id": {
      "type": "string"
    },
    "envio_token": {
      "type": "string"
    },
    "envio_iniciado_em": {
      "type": "string"
    },
    "destinatario_confirmado": {
      "type": "string"
    }
  },
  "required": [
    "job_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "$and": [
            {
              "data.owner_user_id": "{{user.id}}"
            },
            {
              "data.owner_user_id": {
                "$exists": true,
                "$nin": [
                  "",
                  null
                ]
              }
            }
          ]
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "service_role_only"
      }
    },
    "update": {
      "user_condition": {
        "role": "service_role_only"
      }
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}