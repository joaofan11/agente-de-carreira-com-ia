{
  "name": "CandidateDocument",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "owner_user_id": {
      "type": "string"
    },
    "tipo_documento": {
      "type": "string",
      "enum": [
        "ctps",
        "certificado",
        "cpf",
        "rg",
        "diploma",
        "historico",
        "comprovante_residencia",
        "curriculo",
        "outro"
      ],
      "default": "outro"
    },
    "nome_arquivo": {
      "type": "string"
    },
    "referencia_arquivo_privado": {
      "type": "string"
    },
    "status_extracao": {
      "type": "string",
      "enum": [
        "pendente",
        "processando",
        "concluido",
        "erro"
      ],
      "default": "pendente"
    },
    "dados_extraidos": {
      "type": "object"
    },
    "criado_em": {
      "type": "string",
      "format": "date-time"
    },
    "is_demo": {
      "type": "boolean",
      "default": false
    },
    "demo_batch_id": {
      "type": "string"
    }
  },
  "required": [
    "tipo_documento",
    "nome_arquivo"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "$and": [
            {
              "data.owner_user_id": "{{user.id}}"
            },
            {
              "data.owner_user_id": {
                "$exists": true,
                "$nin": [
                  "",
                  null
                ]
              }
            }
          ]
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "service_role_only"
      }
    },
    "update": {
      "user_condition": {
        "role": "service_role_only"
      }
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}