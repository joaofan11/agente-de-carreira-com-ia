{
  "name": "AuditLog",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "acao": {
      "type": "string"
    },
    "entidade": {
      "type": "string"
    },
    "entidade_id": {
      "type": "string"
    },
    "resultado": {
      "type": "string",
      "enum": [
        "sucesso",
        "erro"
      ]
    },
    "data_evento": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "acao",
    "entidade"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}