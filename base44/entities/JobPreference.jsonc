{
  "name": "JobPreference",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "owner_user_id": {
      "type": "string"
    },
    "cargos_interesse": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "areas_interesse": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "niveis": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "estagio",
          "trainee",
          "junior",
          "pleno"
        ]
      }
    },
    "localizacoes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "modalidades": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "presencial",
          "hibrido",
          "remoto",
          "indiferente"
        ]
      }
    },
    "tipos_contrato": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "estagio",
          "trainee",
          "clt",
          "pj",
          "indiferente"
        ]
      }
    },
    "disponibilidade": {
      "type": "string",
      "enum": [
        "imediata",
        "ate_30_dias",
        "ate_60_dias",
        "flexivel"
      ]
    },
    "salario_minimo_opcional": {
      "type": "number"
    },
    "regiao_amazonia": {
      "type": "boolean",
      "default": false
    },
    "notificacoes_ativas": {
      "type": "boolean",
      "default": true
    },
    "is_demo": {
      "type": "boolean",
      "default": false
    },
    "demo_batch_id": {
      "type": "string"
    }
  },
  "required": [],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "$and": [
            {
              "data.owner_user_id": "{{user.id}}"
            },
            {
              "data.owner_user_id": {
                "$exists": true,
                "$nin": [
                  "",
                  null
                ]
              }
            }
          ]
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "service_role_only"
      }
    },
    "update": {
      "user_condition": {
        "role": "service_role_only"
      }
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}