{
  "name": "JobPreference",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "cargos_interesse": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "areas_interesse": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "localizacoes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "modalidades": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "presencial",
          "hibrido",
          "remoto",
          "indiferente"
        ]
      }
    },
    "tipos_contrato": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "estagio",
          "trainee",
          "clt",
          "pj",
          "indiferente"
        ]
      }
    },
    "salario_minimo_opcional": {
      "type": "number"
    },
    "notificacoes_ativas": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}