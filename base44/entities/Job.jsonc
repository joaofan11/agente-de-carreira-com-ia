{
  "name": "Job",
  "type": "object",
  "properties": {
    "source_id": {
      "type": "string"
    },
    "fonte": {
      "type": "string",
      "enum": [
        "manual",
        "api_externa"
      ],
      "default": "manual"
    },
    "empresa": {
      "type": "string"
    },
    "cargo": {
      "type": "string"
    },
    "descricao": {
      "type": "string"
    },
    "requisitos": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "localizacao": {
      "type": "string"
    },
    "modalidade": {
      "type": "string",
      "enum": [
        "presencial",
        "hibrido",
        "remoto"
      ],
      "default": "presencial"
    },
    "nivel": {
      "type": "string",
      "enum": [
        "estagio",
        "trainee",
        "junior",
        "pleno"
      ],
      "default": "estagio"
    },
    "url_original": {
      "type": "string"
    },
    "email_recrutamento": {
      "type": "string"
    },
    "email_recrutamento_validado": {
      "type": "boolean",
      "default": false
    },
    "metodo_candidatura": {
      "type": "string",
      "enum": [
        "email",
        "link_externo",
        "plataforma"
      ],
      "default": "email"
    },
    "api_endpoint": {
      "type": "string"
    },
    "data_publicacao": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "ativa",
        "pausada",
        "encerrada"
      ],
      "default": "ativa"
    },
    "is_demo": {
      "type": "boolean",
      "default": false
    },
    "demo_batch_id": {
      "type": "string"
    }
  },
  "required": [
    "empresa",
    "cargo"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}