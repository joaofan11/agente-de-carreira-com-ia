{
  "name": "Notification",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "application_id": {
      "type": "string"
    },
    "canal": {
      "type": "string",
      "enum": [
        "whatsapp",
        "email",
        "in_app"
      ]
    },
    "direcao": {
      "type": "string",
      "enum": [
        "enviada",
        "recebida"
      ]
    },
    "destino": {
      "type": "string"
    },
    "remetente": {
      "type": "string"
    },
    "conteudo": {
      "type": "string"
    },
    "codigo_aprovacao": {
      "type": "string"
    },
    "decisao": {
      "type": "string",
      "enum": [
        "aprovar",
        "recusar",
        "buscar",
        "desconhecido"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "pendente",
        "enviado",
        "entregue",
        "falhou"
      ],
      "default": "pendente"
    },
    "resultado": {
      "type": "string",
      "enum": [
        "sucesso",
        "erro",
        "ignorado"
      ]
    },
    "erro": {
      "type": "string"
    },
    "identificador_externo": {
      "type": "string"
    },
    "criado_em": {
      "type": "string",
      "format": "date-time"
    },
    "is_demo": {
      "type": "boolean",
      "default": false
    },
    "demo_batch_id": {
      "type": "string"
    }
  },
  "required": [],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}