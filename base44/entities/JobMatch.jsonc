{
  "name": "JobMatch",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "job_id": {
      "type": "string"
    },
    "score": {
      "type": "number"
    },
    "nivel_compatibilidade": {
      "type": "string",
      "enum": [
        "alto",
        "medio",
        "baixo"
      ]
    },
    "justificativas": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "competencias_compativeis": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "competencias_ausentes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "bloqueios": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "requisitos_identificados": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidencias": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dados_insuficientes": {
      "type": "string"
    },
    "data_analise": {
      "type": "string",
      "format": "date-time"
    },
    "is_demo": {
      "type": "boolean",
      "default": false
    },
    "demo_batch_id": {
      "type": "string"
    }
  },
  "required": [
    "job_id"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}