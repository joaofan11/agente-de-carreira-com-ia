{
  "name": "JobMatch",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "owner_user_id": {
      "type": "string"
    },
    "job_id": {
      "type": "string"
    },
    "score": {
      "type": "number"
    },
    "pontuacao_detalhada": {
      "type": "object",
      "properties": {
        "tecnicas": {"type":"number"},
        "formacao": {"type":"number"},
        "experiencia": {"type":"number"},
        "preferencias": {"type":"number"}
      }
    },
    "competencias_evidenciadas": {
      "type":"array",
      "items":{"type":"object","properties":{"competencia":{"type":"string"},"evidencia":{"type":"string"}}}
    },
    "nivel_compatibilidade": {
      "type": "string",
      "enum": [
        "alto",
        "medio",
        "baixo"
      ]
    },
    "justificativas": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "competencias_compativeis": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "competencias_ausentes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "bloqueios": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "requisitos_identificados": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidencias": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dados_insuficientes": {
      "type": "string"
    },
    "data_analise": {
      "type": "string",
      "format": "date-time"
    },
    "is_demo": {
      "type": "boolean",
      "default": false
    },
    "demo_batch_id": {
      "type": "string"
    },
    "cache_fingerprint": {
      "type": "string"
    }
  },
  "required": [
    "job_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "$and": [
            {
              "data.owner_user_id": "{{user.id}}"
            },
            {
              "data.owner_user_id": {
                "$exists": true,
                "$nin": [
                  "",
                  null
                ]
              }
            }
          ]
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "service_role_only"
      }
    },
    "update": {
      "user_condition": {
        "role": "service_role_only"
      }
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}