{
  "name": "CandidateProfile",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "nome_completo": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "telefone_whatsapp": {
      "type": "string"
    },
    "cidade": {
      "type": "string"
    },
    "estado": {
      "type": "string"
    },
    "instituicao": {
      "type": "string"
    },
    "curso": {
      "type": "string"
    },
    "semestre": {
      "type": "string"
    },
    "previsao_conclusao": {
      "type": "string"
    },
    "outras_formacoes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "experiencias": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "empresa": {
            "type": "string"
          },
          "cargo": {
            "type": "string"
          },
          "data_inicio": {
            "type": "string"
          },
          "data_termino": {
            "type": "string"
          },
          "atividades": {
            "type": "string"
          },
          "competencias": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "projetos_academicos": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "nome": {
            "type": "string"
          },
          "descricao": {
            "type": "string"
          },
          "tecnologias": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "resultados": {
            "type": "string"
          },
          "link": {
            "type": "string"
          }
        }
      }
    },
    "competencias": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "idiomas": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ferramentas": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "cursos_complementares": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "nome": {
            "type": "string"
          },
          "instituicao": {
            "type": "string"
          },
          "data_conclusao": {
            "type": "string"
          }
        }
      }
    },
    "resumo_profissional": {
      "type": "string"
    },
    "disponibilidade": {
      "type": "string"
    },
    "atualizado_em": {
      "type": "string",
      "format": "date-time"
    },
    "is_demo": {
      "type": "boolean",
      "default": false
    },
    "demo_batch_id": {
      "type": "string"
    }
  },
  "required": [
    "nome_completo"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.user_id": "{{user.id}}"
        }
      ]
    },
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.user_id": "{{user.id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.user_id": "{{user.id}}"
        }
      ]
    }
  }
}